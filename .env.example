# Copia este archivo como .env y completa los valores.
# NUNCA subas .env a GitHub.

NODE_ENV=development
PORT=3000

# Conexión con el usuario de la aplicación (no el administrador)
DATABASE_URL=postgresql://contanegocios_app:CAMBIAR_ESTA_CLAVE@localhost:5432/contanegocios

# Genera cada clave con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ENCRYPTION_KEY=

# Origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173

# Carpeta de soportes (fuera de la parte pública)
UPLOADS_DIR=./uploads
